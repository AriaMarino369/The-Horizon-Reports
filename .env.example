# Postgres connection string (e.g. from Vercel Storage / Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- THE HORIZON REPORTS ---

# Shared password that unlocks the public site (viewer access).
SITE_PASSWORD="change-me"

# Password for the /admin panel.
ADMIN_PASSWORD="change-me"

# Random secret used to sign session cookies. Generate your own with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Shared secret the weekly cron job must present (Authorization: Bearer <secret>).
CRON_SECRET="change-me"

# Anthropic API key used by the generation pipeline (lib/generateArticle.ts).
# Required for real (non-seeded) article generation. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Caps how many "Ask an Expert" questions get an instant, paid-API answer
# per calendar month (app/actions/askExpert.ts) before every further
# question falls back to the free Claude Code Remote Routine's hourly
# queue — a budget guard so this feature can't run away with the
# ANTHROPIC_API_KEY balance. Optional; defaults to 200/month if unset.
ASK_EXPERT_INSTANT_MONTHLY_CAP="200"

# The site's public URL, used to build links in notifications (e.g. Telegram).
# Falls back to VERCEL_URL (Vercel sets this automatically) if unset.
SITE_URL=""

# Telegram bot credentials for the weekly "new articles published" notification
# (lib/telegramNotify.ts, sent from lib/weeklyRun.ts). Both must be set for
# notifications to go out; if either is missing, the app just logs and skips.
# Create a bot and get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""
# Chat/channel/group ID to post to. For a private chat with the bot, send it
# any message first, then fetch https://api.telegram.org/bot<TOKEN>/getUpdates
# to read your chat id. For a channel, add the bot as admin and use its
# @channelusername or its numeric id (e.g. -1001234567890).
TELEGRAM_CHAT_ID=""
